{
  "name": "sehatkosh",
  "private": true,
  "scripts": {
    "setup": "node -e \"process.platform === 'win32' ? require('child_process').execSync('powershell -ExecutionPolicy RemoteSigned -File ./scripts/setup.ps1', {stdio: 'inherit'}) : require('child_process').execSync('./scripts/setup.sh', {stdio: 'inherit'})\"",
    "dev:mobile": "turbo run dev --filter=@sehatkosh/mobile",
    "dev:web": "turbo run dev --filter=@sehatkosh/doctor-web",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test:backend": "node -e \"const py = process.platform === 'win32' ? 'services\\\\backend\\\\.venv\\\\Scripts\\\\python.exe' : 'services/backend/.venv/bin/python'; require('child_process').execSync(`${py} -m pytest -v`, {cwd: 'services/backend', stdio: 'inherit'})\"",
    "test": "pnpm test:backend",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.7.0"
}
