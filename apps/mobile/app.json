{
  "expo": {
    "name": "SehatKosh",
    "slug": "sehatkosh",
    "scheme": "sehatkosh",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "newArchEnabled": true,
    "android": {
      "package": "com.sehatkosh.app"
    },
    "ios": {
      "bundleIdentifier": "com.sehatkosh.app"
    },
    "plugins": [
      "expo-router",
      "expo-camera"
    ]
  }
}
