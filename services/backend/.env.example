# ==============================================================================
# SehatKosh Backend — Environment Variables
# Copy this to services/backend/.env before running the backend.
# DO NOT commit .env to git.
# ==============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sehatkosh_admin:secure_password123@localhost:5432/sehatkosh_db

# --- Neo4j ------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=secure_neo4j_password

# --- AWS / LocalStack -------------------------------------------------------
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ENDPOINT_URL_EXTERNAL=http://localhost:4566
AWS_ACCESS_KEY_ID=mock_key
AWS_SECRET_ACCESS_KEY=mock_secret
AWS_DEFAULT_REGION=ap-southeast-1
S3_BUCKET_NAME=sehatkosh-prescriptions

# --- OCR Engine (see registry.py for options) --------------------------------
OCR_ENGINE=mock

# --- FHIR Transformer -------------------------------------------------------
FHIR_PARSER=mock

# --- App --------------------------------------------------------------------
APP_ENV=development
DEBUG=true

# --- CORS -------------------------------------------------------------------
# JSON list of allowed frontend origins.
# Example for production: ["https://your-app.vercel.app"]
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
