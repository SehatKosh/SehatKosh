{
  "expo": {
    "name": "SehatKosh",
    "slug": "sehatkosh",
    "scheme": "sehatkosh",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "newArchEnabled": true,
    "android": {
      "package": "com.sehatkosh.app"
    },
    "ios": {
      "bundleIdentifier": "com.sehatkosh.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SehatKosh to access your camera to scan prescriptions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SehatKosh to access your photos to select prescription documents."
        }
      ]
    ]
  }
}
