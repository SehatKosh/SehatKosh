{
  "expo": {
    "name": "SehatKosh",
    "slug": "sehatkosh",
    "scheme": "sehatkosh",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "newArchEnabled": true,
    "android": {
      "package": "com.sehatkosh.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.sehatkosh.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "./plugins/withCleartextTraffic",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SehatKosh to access your camera to scan prescriptions."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow SehatKosh to access your photos to select prescription documents."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "96f8f625-ec39-4132-8b65-0ab64df6b167"
      }
    },
    "owner": "mahsan143"
  }
}
