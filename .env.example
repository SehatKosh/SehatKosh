# ==============================================================================
# SehatKosh — Root Environment Variables
# Copy this file to .env and fill in any secrets before running.
# DO NOT commit .env to git (it is in .gitignore).
# ==============================================================================

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=sehatkosh_admin
POSTGRES_PASSWORD=secure_password123
POSTGRES_DB=sehatkosh_db

# --- Neo4j ----------------------------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=secure_neo4j_password

# --- AWS / LocalStack (S3) -----------------------------------------------
# For local dev, LocalStack emulates S3 on localhost:4566
AWS_ACCESS_KEY_ID=mock_key
AWS_SECRET_ACCESS_KEY=mock_secret
AWS_DEFAULT_REGION=ap-southeast-1
# Internal URL used by the backend container → points to LocalStack container
AWS_ENDPOINT_URL=http://localstack:4566
# External URL used to rewrite pre-signed URLs for browser/mobile clients
AWS_ENDPOINT_URL_EXTERNAL=http://localhost:4566
S3_BUCKET_NAME=sehatkosh-prescriptions

# --- OCR Engine -----------------------------------------------------------
# "mock"             → deterministic mock adapter (default, zero dependencies)
# "plugin:<dotpath>" → e.g. plugin:plugins.gemini_vision.GeminiOCRAdapter
OCR_ENGINE=mock

# --- FHIR Transformer -----------------------------------------------------
FHIR_PARSER=mock

# --- Telemetry Engine -----------------------------------------------------
TELEMETRY_ENGINE=mock

# --- App ------------------------------------------------------------------
APP_ENV=development
DEBUG=true

# --- CORS -----------------------------------------------------------------
# Frontend origins allowed by the FastAPI backend.
# In production, replace with your Vercel deployment URL.
# CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]
